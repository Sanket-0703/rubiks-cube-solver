# Checked in CI with clang-format 23 (scripts/format.sh --check).
BasedOnStyle: Google
IndentWidth: 4
AccessModifierOffset: -4
ColumnLimit: 100
PointerAlignment: Left
DerivePointerAlignment: false
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  # 1: standard library and third-party (<...>), 2: this project ("...").
  # A .cpp file's own header always comes first.
  - Regex: '^<.*>'
    Priority: 1
  - Regex: '^".*"'
    Priority: 2
